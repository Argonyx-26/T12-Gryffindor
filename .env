# ==============================================================================
# GRYFFINDOR SENTINEL — Backend Connection Configuration
# ==============================================================================
#
# LOCAL BACKEND (Default):
# VITE_WS_URL=ws://localhost:8000/ws/alerts
# VITE_API_URL=http://localhost:8000
#
# DIFFERENT LAPTOP ON SAME WI-FI / LAN:
# Replace <BACKEND_LAPTOP_IP> with the other laptop's IP address (e.g., 192.168.1.100)
# VITE_WS_URL=ws://192.168.1.100:8000/ws/alerts
# VITE_API_URL=http://192.168.1.100:8000
# ==============================================================================

# WebSocket endpoint for real-time security alert stream
VITE_WS_URL=ws://localhost:8000/ws/alerts

# REST API endpoint for actions (Dispatch & False Positive feedback)
VITE_API_URL=http://localhost:8000
