# ==============================================================================
# GRYFFINDOR SENTINEL — Environment Variables Example Template
# Duplicate this file as '.env' and update IP addresses as needed.
# ==============================================================================

# WebSocket endpoint (use backend host IP if running on a different machine, e.g. ws://192.168.1.50:8000/ws/alerts)
VITE_WS_URL=ws://localhost:8000/ws/alerts

# REST API base URL (use backend host IP if running on a different machine, e.g. http://192.168.1.50:8000)
VITE_API_URL=http://localhost:8000
