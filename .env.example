# ==============================================================================
# GRYFFINDOR SENTINEL — Production & Development Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL 16+)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gryffindor

# Redis Connection (Redis 7+)
REDIS_URL=redis://localhost:6379/0

# Historical Data Retention Policies (in Days)
EVENT_RETENTION_DAYS=30
INCIDENT_RETENTION_DAYS=90

# API & WebSocket Endpoints for Multi-Laptop / Network Deployment
HUB_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/alerts

# Operational Settings
LOG_LEVEL=INFO
ALLOW_SQLITE_FALLBACK=true
